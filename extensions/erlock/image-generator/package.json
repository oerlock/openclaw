{
  "name": "@openclaw/image-generator",
  "version": "2026.3.22",
  "description": "DashScope Qwen image generator plugin for OpenClaw",
  "type": "module",
  "devDependencies": {
    "openclaw": "file:../../.."
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@openclaw/image-generator",
      "localPath": "extensions/erlock/image-generator",
      "defaultChoice": "local"
    }
  }
}
